# Скопируйте в deploy.env в корне проекта и заполните.
# deploy.env в git не попадает: он в .gitignore.

# Имя хоста из ~/.ssh/config либо строка вида пользователь@сервер.
# На этой машине настроен booking-prod (vip304.hosting.reg.ru, u3567033),
# но он заведён под проект бронирования. Проверьте, на этом ли сервере
# tex-biz.ru:  ssh booking-prod 'ls ~/data/www/'
DEPLOY_SSH_HOST=booking-prod

# Каталог домена на сервере.
DEPLOY_REMOTE_PATH=/var/www/u3567033/data/www/tex-biz.ru

# Виртуальное окружение приложения. По умолчанию .venv внутри каталога сайта.
# В ISPmanager окружение часто лежит в другом месте — посмотрите на странице
# Python-приложения.
DEPLOY_VENV=

# Куда складывать резервные копии на СЕРВЕРЕ. Каталог должен быть вне корня
# сайта. Кавычки одинарные не случайно: без них $HOME подставится с вашей
# машины, и копия уедет в локальный путь вместо серверного.
DEPLOY_BACKUP_DIR='$HOME/texbiz-backups'

# Адрес для приёмки после выкладки.
DEPLOY_SITE_URL=https://tex-biz.ru
