# Скопируйте в deploy.env в корне проекта и проверьте значения.
# deploy.env в git не попадает: он в .gitignore.
#
# Значения ниже взяты из соседнего проекта booking-engine: он живёт на том же
# аккаунте того же хостинга, и соглашения там уже обкатаны. Перед первой
# настоящей выкладкой прогоните `bash scripts/deploy.sh --dry-run`.
#
# Кавычки одинарные не случайно: без них $HOME подставится с вашей машины,
# и всё уедет в локальный путь вместо серверного.

# Имя хоста из ~/.ssh/config.
DEPLOY_SSH_HOST=booking-prod

# Каталог сайта на сервере. У booking-engine установки лежат как
# ~/www/<домен>, отсюда и путь. Проверить: ssh booking-prod 'ls ~/www/'
DEPLOY_REMOTE_PATH='$HOME/www/tex-biz.ru'

# Виртуальное окружение с Django. У booking-engine оно вынесено из каталога
# сайта (~/booking-engine/bin/python) — так его не задевает rsync --delete.
# Для этого сайта окружение нужно создать один раз:
#   ssh booking-prod 'python3 -m venv ~/texbiz-venv'
# Если у действующего сайта уже есть своё окружение от ISPmanager, укажите его.
DEPLOY_VENV='$HOME/texbiz-venv'

# Куда складывать резервные копии на СЕРВЕРЕ. Вне каталога сайта.
DEPLOY_BACKUP_DIR='$HOME/texbiz-backups'

# Адрес для приёмки после выкладки.
DEPLOY_SITE_URL=https://tex-biz.ru
