# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Обязательно на сервере: длинная случайная строка.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 только на локальной машине. На сервере — 0 или не задавать.
DJANGO_DEBUG=0

# HSTS. Начинаем с часа; поднять до 31536000, когда HTTPS отработает без
# нареканий. DJANGO_HSTS_SUBDOMAINS включать, только когда известен список
# поддоменов tex-biz.ru и у каждого есть сертификат: откатить нельзя.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_SUBDOMAINS=0

DJANGO_ALLOWED_HOSTS=tex-biz.ru,www.tex-biz.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://tex-biz.ru,https://www.tex-biz.ru

# Куда приходят заявки (через запятую)
LEAD_NOTIFY_EMAILS=info@tex-biz.ru

# SMTP хостинга. Пусто — письма печатаются в лог, заявка всё равно сохраняется.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@tex-biz.ru

# Дубль заявки в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ГЛАВНАЯ ЗАЩИТА ДАННЫХ. Каталог с базой заявок и логами. По умолчанию это
# data/ внутри проекта, то есть внутри корня сайта, откуда веб-сервер отдаёт
# файлы. Проверка действующего сайта 06.09.2026 показала, что правила из
# .htaccess на этом хостинге не применяются (перенаправление с www не
# работает), поэтому на .htaccess полагаться нельзя.
# Укажите каталог ВЫШЕ корня домена, например /var/www/<пользователь>/texbiz-data
DJANGO_DATA_DIR=

# Прочее
SITE_URL=https://tex-biz.ru
YANDEX_METRIKA_ID=110630521
BOOKING_DEMO_URL=https://demo.booking-engine.ru/
